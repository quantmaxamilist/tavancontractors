---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import Mark from '../components/site/Mark.astro';
import { company, phones, email, areas } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  headerOverlay?: boolean;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}
const { title, description, ogImage = '/og.jpg', headerOverlay = false, noindex = false, schema = [] } = Astro.props;
const site = Astro.site!.origin;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '').replace(/\/$/, '') || '/';
const canonical = site + (path === '/' ? '' : path);

const business = {
  '@context': 'https://schema.org',
  '@type': 'RoofingContractor',
  name: company.name,
  legalName: company.legal,
  url: site,
  logo: site + '/brand/tavan-badge-512.png',
  image: site + '/og.jpg',
  telephone: phones.free.display,
  email,
  address: { '@type': 'PostalAddress', streetAddress: company.address[0], addressLocality: company.address[1], postalCode: company.address[2], addressCountry: 'GB' },
  areaServed: areas,
  sameAs: Object.values(company.social),
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tavan Contractors" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site + ogImage} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        try { if (sessionStorage.getItem('tavan:pt')) d.classList.add('pt-arrive'); } catch (e) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header overlay={headerOverlay} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div id="cursor" class="cursor" aria-hidden="true"><span class="cursor__ring"></span><span class="cursor__dot"></span></div>
    <div id="pt" class="pt" aria-hidden="true"><Mark stroke="#cc5500" /></div>
    <script>
      import '../scripts/core.js';
    </script>
  </body>
</html>
