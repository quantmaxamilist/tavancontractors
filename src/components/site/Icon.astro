---
// Small inline icon set (stroke icons, currentColor).
interface Props { name: 'phone' | 'mail' | 'arrow' | 'arrow-ul' | 'star' | 'play' | 'close' | 'chev' | 'menu' | 'pin' | 'replay' | 'facebook' | 'instagram' | 'check' | 'left' | 'right' | 'mobile'; class?: string; label?: string }
const { name, class: cls, label } = Astro.props;
const a = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" {...a}>
  {name === 'phone' && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 5.2 5.2l1.4-2.1 4.2 1.6V17a2.5 2.5 0 0 1-2.7 2.5A15.5 15.5 0 0 1 2.5 6.2 2.5 2.5 0 0 1 5 3.5Z" />}
  {name === 'mobile' && <><rect x="6.5" y="2.5" width="11" height="19" rx="2" /><path d="M10.5 18.5h3" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'arrow-ul' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'left' && <path d="M20 12H5m6-6-6 6 6 6" />}
  {name === 'right' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'star' && <path fill="currentColor" stroke="none" d="m12 2.8 2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8Z" />}
  {name === 'play' && <path fill="currentColor" stroke="none" d="M8 5.5v13l10.5-6.5Z" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'chev' && <path d="m6 9 6 6 6-6" />}
  {name === 'menu' && <path d="M3.5 8h17M3.5 16h17" />}
  {name === 'pin' && <><path d="M12 21s7-6.2 7-11.5a7 7 0 1 0-14 0C5 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === 'replay' && <><path d="M4 12a8 8 0 1 0 2.4-5.7" /><path d="M4 4v4.5h4.5" /></>}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'facebook' && <path fill="currentColor" stroke="none" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4a21 21 0 0 0-2.3-.1c-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21Z" />}
  {name === 'instagram' && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" /></>}
</svg>
