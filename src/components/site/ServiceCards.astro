---
import Img from './Img.astro';
import Icon from './Icon.astro';
import { services } from '../../data/site';
import { pad, wrapSlash } from '../../data/extra';
interface Props { exclude?: string }
const list = services.filter((s) => s.slug !== Astro.props.exclude);
---
<ul class="sc" role="list">
  {list.map((s) => {
    const i = services.indexOf(s);
    return (
      <li data-reveal="fade">
        <a href={`/services/${s.slug}`} class="sc__card">
          <div class="ph sc__ph"><Img id={s.hero} alt={`${s.name} by Tavan Contractors`} sizes="(max-width: 700px) 100vw, 25vw" /></div>
          <div class="sc__body"><span class="label o">{pad(i + 1)}</span><span class="sc__name">{wrapSlash(s.name)}</span><Icon name="arrow" /></div>
        </a>
      </li>
    );
  })}
</ul>
<style>
  .sc { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 24px); list-style: none; padding: 0; }
  .sc__card { display: grid; background: var(--white); height: 100%; }
  .sc__ph { aspect-ratio: 4 / 3; }
  .sc__ph img { transition: transform 0.8s var(--ease-out); }
  .sc__card:hover .sc__ph img { transform: scale(1.05); }
  .sc__body { display: grid; grid-template-columns: auto minmax(0, 1fr) 18px; gap: 10px; align-items: center; padding: 16px 18px; border-top: 3px solid var(--orange); }
  .sc__name { font-weight: 650; }
  .sc__body svg { width: 18px; height: 18px; transition: transform 0.3s var(--ease-out); }
  .sc__card:hover .sc__body svg { transform: translateX(4px); }
  @media (max-width: 1000px) { .sc { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .sc { grid-template-columns: minmax(0, 1fr); } }
</style>
