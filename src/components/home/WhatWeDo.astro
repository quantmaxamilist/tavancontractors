---
import Img from '../site/Img.astro';
import Icon from '../site/Icon.astro';
import { home } from '../../data/site';
const cards = [
  { ...home.residential, href: '/services', id: '0f627bb', alt: 'Clay-tiled dormer roof on a family home' },
  { ...home.commercial, href: '/commercial', id: 'f1c6ea0', alt: 'Commercial new-build terrace roofed by Tavan Contractors' },
];
---
<section class="wwd white sec" data-header-theme="light" aria-labelledby="wwd-h">
  <div class="container">
    <h2 id="wwd-h" class="display d-2" data-reveal="lines"><span class="line"><span>{home.whatHead[0]} <span class="o">{home.whatHead[1]}</span></span></span></h2>
    <div class="wwd__grid">
      {cards.map((c, i) => (
        <a href={c.href} class="wwd__card" data-reveal="fade" data-delay={i * 0.1}>
          <div class="ph wwd__ph"><Img id={c.id} alt={c.alt} sizes="(max-width: 900px) 100vw, 46vw" /></div>
          <div class="wwd__body">
            <h3 class="display d-3">{c.head}</h3>
            <p>{c.body}</p>
            <span class="arrow-link">{c.cta} <Icon name="arrow" /></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .wwd__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); margin-top: clamp(32px, 4vw, 56px); }
  .wwd__card { display: grid; grid-template-rows: auto 1fr; background: var(--paper); }
  .wwd__ph { aspect-ratio: 16 / 11; }
  .wwd__ph img { transition: transform 0.9s var(--ease-out); }
  .wwd__card:hover .wwd__ph img { transform: scale(1.04); }
  .wwd__body { display: grid; gap: 14px; align-content: start; padding: clamp(22px, 3vw, 36px); border-top: 4px solid var(--orange); }
  .wwd__body p { color: var(--ink-2); max-width: 46ch; }
  .wwd__body .arrow-link { margin-top: 6px; }
  .wwd__card:hover .arrow-link svg { transform: translateX(4px); }
  @media (max-width: 799px) { .wwd__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
