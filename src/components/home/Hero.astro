---
// Home hero: a slow "film" of Tavan's own site photos (landscape set on wide screens, portrait set on
// phones). On the first visit per session, the house outline from the badge opens as a window onto
// the film and flies past the camera (≤2.5s; any click, key, wheel or touch skips to the end).
import Icon from '../site/Icon.astro';
import { img, telHref, quoteHref } from '../../data/extra';
import { home, phones } from '../../data/site';

const wide = ['e61e908', '31edd10', 'f1c6ea0', '5b9cda5'];
const tall = ['863c645', '90c82a0', '4d34de8', '93a966d'];
const alts = [
  'New-build homes roofed by Tavan Contractors',
  'Tavan roofer on a scaffolded new-build site',
  'Scaffolded terrace during re-roofing',
  'Completed new-build house with tiled roof',
];
---
<section class="hero dark" id="hero" data-header-theme="dark" aria-labelledby="hero-h">
  <div class="hero__film" data-film>
    {wide.map((id, i) => {
      const w = img(id);
      const t = img(tall[i]);
      return (
        <picture class:list={['hero__slide', { 'is-on': i === 0 }]} data-slide>
          <source media="(max-aspect-ratio: 1/1)" {...(i === 0 ? { srcset: t.srcset } : { 'data-srcset': t.srcset })} sizes="100vw" width={t.width} height={t.height} />
          <img
            {...(i === 0 ? { src: w.src, srcset: w.srcset } : { 'data-srcset': w.srcset, 'data-src': w.src })}
            sizes="100vw"
            width={w.width}
            height={w.height}
            alt={i === 0 ? alts[i] : ''}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding={i === 0 ? 'sync' : 'async'}
          />
        </picture>
      );
    })}
    <div class="hero__shade" aria-hidden="true"></div>
  </div>

  <div class="hero__intro" aria-hidden="true" data-intro hidden>
    <svg viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice">
      <path fill="#0b0b0c" fill-rule="evenodd" d="M-2000-2000H3000V3000H-2000Z M500 330 L616 440 V604 H384 V440 Z" />
      <path class="hero__intro-line" fill="none" stroke="#cc5500" stroke-width="2.5" vector-effect="non-scaling-stroke" pathLength="1" d="M500 330 L616 440 V604 H384 V440 Z" />
    </svg>
  </div>

  <div class="container hero__in">
    <p class="label hero__kicker" data-hero-in>Domestic &amp; Commercial Roofing <span aria-hidden="true">—</span> Bracknell</p>
    <h1 id="hero-h" class="display d-hero hero__h">
      <span class="line"><span class="o">{home.headline[0]}</span></span>
      <span class="line"><span>{home.headline[1]}</span></span>
      <span class="line"><span class="o">{home.headline[2]}</span></span>
    </h1>
    <div class="hero__foot">
      <div class="hero__cta" data-hero-in>
        <p class="hero__line">{home.quoteLine}</p>
        <div class="hero__btns">
          <a href={quoteHref()} class="btn btn--orange" data-magnetic>{home.quoteBtn} <Icon name="arrow" /></a>
          <a href={telHref()} class="btn btn--line hero__tel"><Icon name="phone" /> <span>{phones.free.display}</span> <span class="btn__sub">{phones.free.label}</span></a>
        </div>
      </div>
      <div class="hero__meta" data-hero-in>
        <div class="hero__count label" aria-hidden="true"><span data-film-n>01</span> / 0{wide.length}</div>
        <div class="hero__bars" aria-hidden="true">{wide.map(() => <i><b></b></i>)}</div>
        <button class="hero__film-btn" type="button" data-film-open aria-haspopup="dialog">
          <span class="hero__play"><Icon name="play" /></span>
          <span><span class="label">Watch our film</span><span class="hero__dur">0:31</span></span>
        </button>
      </div>
    </div>
  </div>
</section>

<dialog class="film-dlg" id="film-dlg" aria-label="Tavan Contractors film">
  <button class="film-dlg__x" type="button" data-film-close aria-label="Close film"><Icon name="close" /></button>
  <video controls playsinline preload="none" poster="/video/tavan-film-poster.webp" width="1920" height="1080">
    <source src="/video/tavan-film-720.mp4" type="video/mp4" media="(max-width: 760px)" />
    <source src="/video/tavan-film-1080.mp4" type="video/mp4" />
  </video>
</dialog>

<style>
  .hero { position: relative; height: 100svh; min-height: 620px; max-height: 1200px; overflow: hidden; isolation: isolate; }
  .hero__film { position: absolute; inset: 0; z-index: -1; background: var(--black); }
  .hero__slide { position: absolute; inset: 0; opacity: 0; }
  .hero__slide.is-on { opacity: 1; }
  .hero__slide img { width: 100%; height: 100%; object-fit: cover; transform-origin: 60% 50%; will-change: transform; }
  .hero__shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(11, 11, 12, 0.82) 0%, rgba(11, 11, 12, 0.5) 42%, rgba(11, 11, 12, 0.06) 75%),
      linear-gradient(0deg, rgba(11, 11, 12, 0.88) 0%, rgba(11, 11, 12, 0) 48%);
  }
  .hero__intro { position: absolute; inset: 0; z-index: 3; pointer-events: none; will-change: transform; transform-origin: 50% 46.7%; }
  .hero__intro svg { width: 100%; height: 100%; }

  .hero__in { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; padding-top: calc(var(--header-h) + var(--strip-h) + 24px); padding-bottom: clamp(28px, 5vh, 56px); }
  .hero__kicker { color: var(--orange-hi); margin-bottom: 18px; }
  .hero__h { max-width: 14ch; }
  .hero__foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-top: clamp(20px, 3.4vh, 36px); flex-wrap: wrap; }
  .hero__line { font-size: var(--fs-lead); font-weight: 500; margin-bottom: 18px; color: #e6e6e8; }
  .hero__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__tel span:first-of-type { font-weight: 650; letter-spacing: 0.01em; }
  .hero__meta { display: grid; justify-items: end; gap: 14px; }
  .hero__count { color: var(--mute); }
  .hero__count span { color: var(--white); }
  .hero__bars { display: flex; gap: 6px; }
  .hero__bars i { width: 34px; height: 2px; background: rgba(255, 255, 255, 0.22); overflow: hidden; }
  .hero__bars b { display: block; height: 100%; background: var(--orange-hi); transform: scaleX(0); transform-origin: left; }
  .hero__film-btn { display: inline-flex; align-items: center; gap: 12px; text-align: left; }
  .hero__play { width: 46px; height: 46px; border-radius: 50%; border: 1.5px solid rgba(255, 255, 255, 0.5); display: grid; place-items: center; transition: background-color var(--t-fast), border-color var(--t-fast); }
  .hero__play svg { width: 16px; height: 16px; margin-left: 2px; }
  .hero__film-btn:hover .hero__play { background: var(--orange); border-color: var(--orange); color: var(--black); }
  .hero__film-btn > span:last-child { display: grid; }
  .hero__dur { font-size: 0.85rem; color: var(--mute); }

  @media (max-width: 899px) {
    .hero { min-height: 560px; }
    .hero__shade { background: linear-gradient(0deg, rgba(11, 11, 12, 0.92) 0%, rgba(11, 11, 12, 0.55) 55%, rgba(11, 11, 12, 0.25) 100%); }
    .hero__meta { justify-items: start; grid-auto-flow: column; align-items: center; }
    .hero__bars, .hero__count { display: none; }
  }
  @media (max-width: 420px) { .hero__btns .btn { flex: 1 1 100%; } }

  /* start state when JS runs; a 3s CSS safety net shows everything even if scripts fail */
  :global(.rv) .hero__h .line > span { transform: translateY(110%); animation: hero-safe 0s 3s forwards; }
  :global(.rv) [data-hero-in] { opacity: 0; animation: hero-safe 0s 3s forwards; }
  @keyframes hero-safe { to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.rv) .hero__h .line > span { transform: none; animation: none; }
    :global(.rv) [data-hero-in] { opacity: 1; animation: none; }
  }

  .film-dlg { padding: 0; border: 0; background: transparent; width: min(1200px, 92vw); max-width: none; overflow: visible; }
  .film-dlg::backdrop { background: rgba(11, 11, 12, 0.9); }
  .film-dlg video { width: 100%; height: auto; aspect-ratio: 16 / 9; background: #000; }
  .film-dlg__x { position: absolute; right: 0; top: -54px; width: 44px; height: 44px; display: grid; place-items: center; color: var(--white); }
  .film-dlg__x svg { width: 26px; height: 26px; }
</style>

<script>
  import { gsap, lenis, reduced, arrived } from '../../scripts/core.js';

  const hero = document.getElementById('hero');
  if (hero) {
    const slides = [...hero.querySelectorAll('[data-slide]')];
    const bars = [...hero.querySelectorAll('.hero__bars b')];
    const nEl = hero.querySelector('[data-film-n]');
    const imgs = slides.map((s) => s.querySelector('img'));

    // Load the other film frames once the page has loaded (keeps LCP to the first frame).
    const hydrate = () => slides.forEach((s) => s.querySelectorAll('[data-srcset]').forEach((el) => {
      el.setAttribute('srcset', el.dataset.srcset);
      if (el.dataset.src) el.setAttribute('src', el.dataset.src);
      el.removeAttribute('data-srcset');
    }));
    if (document.readyState === 'complete') hydrate(); else addEventListener('load', hydrate, { once: true });

    // ---- film: 5.5s per frame, slow push-in (transform) + 1.2s crossfade (opacity) ----
    const HOLD = 5.5;
    let i = 0;
    let film = null;
    const step = () => {
      const cur = slides[i];
      const next = (i + 1) % slides.length;
      gsap.fromTo(bars[i], { scaleX: 0 }, { scaleX: 1, duration: HOLD, ease: 'none' });
      gsap.fromTo(imgs[i], { scale: 1.02 }, { scale: 1.1, duration: HOLD + 1.2, ease: 'none' });
      film = gsap.delayedCall(HOLD, () => {
        gsap.set(bars[i], { scaleX: 0 });
        gsap.set(slides[next], { opacity: 0 });
        slides[next].classList.add('is-on');
        gsap.to(slides[next], { opacity: 1, duration: 1.2, ease: 'power1.inOut', onComplete: () => { cur.classList.remove('is-on'); gsap.set(cur, { opacity: 0 }); } });
        i = next;
        if (nEl) nEl.textContent = String(i + 1).padStart(2, '0');
        step();
      });
    };
    const playFilm = () => { if (!reduced && !film) step(); };
    // Pause the film when the hero is off screen.
    new IntersectionObserver(([e]) => {
      if (reduced || !film) return;
      const tw = gsap.getTweensOf([...imgs, ...bars, ...slides]);
      if (e.isIntersecting) { film.resume(); tw.forEach((t) => t.resume()); }
      else { film.pause(); tw.forEach((t) => t.pause()); }
    }).observe(hero);

    // ---- intro: house window flies past the camera ----
    const intro = hero.querySelector('[data-intro]');
    const lines = hero.querySelectorAll('.hero__h .line > span');
    const ins = hero.querySelectorAll('[data-hero-in]');
    let seen = false;
    try { seen = !!sessionStorage.getItem('tavan:intro'); sessionStorage.setItem('tavan:intro', '1'); } catch { seen = true; }
    const atTop = scrollY < 40;

    const settle = () => gsap.timeline()
      .fromTo(lines, { yPercent: 110, y: 0 }, { yPercent: 0, duration: 0.8, ease: 'expo.out', stagger: 0.07 }, 0)
      .fromTo(ins, { opacity: 0 }, { opacity: 1, duration: 0.6, ease: 'power2.out', stagger: 0.08 }, 0.2);

    if (!reduced && !seen && atTop && intro) {
      document.documentElement.classList.add('intro-on');
      intro.hidden = false;
      const line = intro.querySelector('.hero__intro-line');
      const tl = gsap.timeline({
        onComplete: () => {
          intro.hidden = true;
          document.documentElement.classList.remove('intro-on');
          off();
          playFilm();
        },
      });
      tl.fromTo(line, { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.6, ease: 'power2.inOut' }, 0)
        .fromTo(imgs[0], { scale: 1.3 }, { scale: 1.02, duration: 2.0, ease: 'power3.inOut' }, 0)
        .to(intro, { scale: 34, duration: 1.0, ease: 'power3.in' }, 0.55)
        .to(line, { opacity: 0, duration: 0.3 }, 1.3)
        .add(settle(), 1.0);
      const skip = () => { if (tl.progress() < 1) tl.progress(1); };
      const evs = ['pointerdown', 'keydown', 'wheel', 'touchstart'];
      const off = () => evs.forEach((ev) => removeEventListener(ev, skip));
      evs.forEach((ev) => addEventListener(ev, skip, { passive: true }));
    } else {
      arrived.then(() => { if (!reduced) settle(); playFilm(); });
    }

    // ---- film dialog ----
    const dlg = document.getElementById('film-dlg');
    const vid = dlg?.querySelector('video');
    const close = () => { vid?.pause(); if (dlg?.open) dlg.close(); lenis?.start(); };
    hero.querySelector('[data-film-open]')?.addEventListener('click', () => {
      if (!dlg) return;
      dlg.showModal();
      lenis?.stop();
      vid?.play().catch(() => {});
    });
    dlg?.querySelector('[data-film-close]')?.addEventListener('click', close);
    dlg?.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg?.addEventListener('cancel', () => { vid?.pause(); lenis?.start(); });
    dlg?.addEventListener('close', () => { vid?.pause(); lenis?.start(); });
  }
</script>
