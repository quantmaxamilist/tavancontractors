---
import Img from '../site/Img.astro';
import Icon from '../site/Icon.astro';
const shots = [
  { id: '90c82a0', alt: 'Battens over breathable membrane on a re-roof' },
  { id: 'e61e908', alt: 'Finished new-build gable with tiled roof' },
  { id: '863c645', alt: 'Clay-tiled ridge on a new roof' },
  { id: '40d087e', alt: 'Slate dormer and chimney' },
  { id: '7fdde72', alt: 'Flat roof with rooflights' },
  { id: '0f627bb', alt: 'Clay-tiled dormer roof' },
];
---
<section class="reel dark sec" data-header-theme="dark" aria-labelledby="reel-h">
  <div class="container reel__head">
    <h2 id="reel-h" class="display d-2" data-reveal="lines"><span class="line"><span>Our <span class="o">Work</span></span></span></h2>
    <a href="/our-work" class="arrow-link" data-reveal="fade">View Our Work <Icon name="arrow" /></a>
  </div>
  <div class="container reel__grid">
    {shots.map((s, i) => (
      <a href="/our-work" class:list={['ph', 'reel__item', `reel__item--${i + 1}`]} data-reveal="photo" data-delay={(i % 3) * 0.08} aria-label={`${s.alt} — view our work`}>
        <Img id={s.id} alt={s.alt} sizes="(max-width: 900px) 50vw, 33vw" />
      </a>
    ))}
  </div>
</section>

<style>
  .reel__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .reel__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: clamp(120px, 15vw, 230px); gap: clamp(8px, 1.2vw, 16px); margin-top: clamp(28px, 4vw, 52px); }
  .reel__item img { transition: transform 0.9s var(--ease-out); }
  .reel__item:hover img { transform: scale(1.05); }
  .reel__item--1 { grid-column: 1 / 5; grid-row: span 2; }
  .reel__item--2 { grid-column: 5 / 10; grid-row: span 1; }
  .reel__item--3 { grid-column: 10 / 13; grid-row: span 2; }
  .reel__item--4 { grid-column: 5 / 8; grid-row: span 1; }
  .reel__item--5 { grid-column: 8 / 10; grid-row: span 1; }
  .reel__item--6 { display: none; }
  @media (max-width: 799px) {
    .reel__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 44vw; }
    .reel__item--1, .reel__item--2, .reel__item--3, .reel__item--4, .reel__item--5, .reel__item--6 { grid-column: auto; grid-row: auto; display: block; }
  }
</style>
